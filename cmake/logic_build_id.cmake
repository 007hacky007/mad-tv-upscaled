# Build id of the game logic library: SHA-256 over the generated translation and the runtime it is compiled with.
# Run at build time (cmake -P) after the translator; writes <OUT_H> (MTV_LOGIC_BUILD_ID) and <OUT_TXT>.
# Inputs: GEN (generated sources), ROOT (source tree), OUT_H, OUT_TXT.
file(GLOB cpp "${GEN}/*.cpp")
file(GLOB hdr "${GEN}/*.h")
list(SORT cpp)
list(SORT hdr)
set(files ${cpp} ${hdr})
list(FILTER files EXCLUDE REGEX "/(state_layout\\.cpp|logic_build_id\\.h)$")
foreach(r src/rt/cpu.h src/rt/cpu.cpp src/rt/machine.h src/rt/blobs.h src/rt/logic.h src/rt/logic_export.cpp)
  list(APPEND files "${ROOT}/${r}")
endforeach()
set(parts "")
foreach(f ${files})
  file(SHA256 "${f}" h)
  list(APPEND parts "${h}")
endforeach()
list(JOIN parts ":" joined)
string(SHA256 id "${joined}")
string(SUBSTRING "${id}" 0 16 id)
set(header "#pragma once\n#define MTV_LOGIC_BUILD_ID \"${id}\"\n")
if(EXISTS "${OUT_H}")
  file(READ "${OUT_H}" old)
else()
  set(old "")
endif()
if(NOT old STREQUAL header)
  file(WRITE "${OUT_H}" "${header}")
endif()
file(WRITE "${OUT_TXT}" "${id}\n")
